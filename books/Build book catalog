name: Build book catalog

on:
  push:
    branches: [main]
    paths:
      - "books/**"
      - "tools/build_catalog.py"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  catalog:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install pillow
      - run: python3 tools/build_catalog.py --repo "${{ github.repository }}" --branch main
      - name: Commit catalog
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add catalog.xml feeds covers
          if git diff --cached --quiet; then
            echo "Catalog unchanged"
          else
            git commit -m "Rebuild book catalog"
            git push
          fi
